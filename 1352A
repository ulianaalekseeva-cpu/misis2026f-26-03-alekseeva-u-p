#include <iostream>
#include <vector>
#include <string>

using namespace std;

void solve() {
    string s;
    cin >> s;

    vector<int> ans;
    int n = s.length();

    for (int i = 0; i < n; ++i) {
        if (s[i] != '0') {
            int digit = s[i] - '0';
            int power = 1;
            for (int j = 0; j < n - 1 - i; ++j) {
                power *= 10;
            }
            ans.push_back(digit * power);
        }
    }

    cout << ans.size() << "\n";

    for (int i = 0; i < ans.size(); ++i) {
        cout << ans[i] << (i == ans.size() - 1 ? "" : " ");
    }
    cout << "\n";
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
